{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "quark-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "backend.app:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "port": 8000
    },
    {
      "name": "quark-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "--port", "5183"],
      "port": 5183
    }
  ]
}
